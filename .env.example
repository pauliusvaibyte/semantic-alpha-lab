SEMANTIC_ALPHA_DB=./data/semantic_alpha.db
TYPESAFE_API_KEY=
X_API_KEY=
BYBIT_BASE_URL=https://api.bybit.com
X_API_URL=https://api.twitterapi.io/twitter/tweet/advanced_search
X_BASE_URL=https://api.twitterapi.io
X_WS_URL=wss://ws.twitterapi.io/twitter/tweet/websocket
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
JEV_MODEL=jev-latest

# xAI/Grok model API (api.x.ai) — not an X data source; reserved for a future
# Grok semantic engine to compare against Jev.
XAI_API_KEY=

# Query language filter for X search/stream rules (empty = all languages).
X_QUERY_LANGS=en

# Second venue for cross-venue dispersion features (public endpoints, no key).
BINANCE_BASE_URL=https://fapi.binance.com

# Comma-separated X handles treated as deterministic official sources
# (feeds official_account_rate_* features; lowercase, no @).
OFFICIAL_X_ACCOUNTS=

# Primary-source RSS/Atom feeds polled by collect-news: name=url pairs.
NEWS_FEEDS=

# Cost accounting assumptions; update if provider pricing changes.
JEV_INPUT_USD_PER_M=0.042
X_COST_PER_POST_USD=0.00015
FIXED_MONTHLY_DATA_USD=0
